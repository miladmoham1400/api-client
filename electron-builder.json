{
  "appId": "local.offline-api-client",
  "productName": "offline-api-client",
  "directories": {
    "output": "dist/linux"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*"
  ],
  "npmRebuild": true,
  "nativeRebuilder": "sequential",
  "publish": null,
  "linux": {
    "icon": "build/icons",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Development",
    "executableName": "offline-api-client",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "syncDesktopName": true
  },
  "deb": {
    "maintainer": "Offline API Client contributors <maintainers@example.invalid>"
  }
}
