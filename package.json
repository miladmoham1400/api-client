{
  "name": "offline-api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Offline desktop HTTP client",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=11.6.2 <12"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:smoke": "npm run build && playwright test",
    "build": "npm run typecheck && electron-vite build",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
