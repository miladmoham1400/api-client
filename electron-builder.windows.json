{
  "extends": "./electron-builder.json",
  "directories": {
    "output": "dist/windows"
  },
  "forceCodeSigning": false,
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${name}-${version}-${arch}-setup.${ext}",
    "signExecutable": false,
    "files": [
      "package.json",
      "!node_modules/better-sqlite3/prebuilds/!(win32-${arch}).node"
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "differentialPackage": false
  }
}
